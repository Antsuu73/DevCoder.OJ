# Biến môi trường cho DevCoder.OJ

# Bắt buộc trên production (Render tự generate)
JWT_SECRET=your-secret-key-here

# Turso Database (miễn phí) — lưu tài khoản vĩnh viễn
# Tạo tại: https://turso.tech → New Database → copy URL và Token
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Tùy chọn — nếu không dùng Turso, SQLite lưu local (chỉ dùng khi dev)
# DB_PATH=./data/oj.db

# Tùy chọn — Google Login
# GOOGLE_CLIENT_ID=
